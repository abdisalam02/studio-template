NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Resend → Webhooks signing secret (whsec_...). Required by
# /api/webhooks/resend so a bounce can be matched back to its booking.
RESEND_WEBHOOK_SECRET=

# Cloudflare Turnstile (booking spam protection). The matching site key lives
# in Noire/js/config.js as turnstileSiteKey. Leave both empty to disable.
TURNSTILE_SECRET_KEY=

# Secret for /api/cron/reminders (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# Days before closed bookings are anonymised by the daily retention pass in
# /api/cron/reminders. Must be >= 30 (default 365).
RETENTION_DAYS=365
