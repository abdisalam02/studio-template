# Supabase. The service-role key is server-only — never expose it as NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (OTP, booking, onboarding).
RESEND_API_KEY=

# Optional but recommended in production: peppers admin session hashes.
# Rotating it invalidates every existing admin session (users re-login).
SESSION_SECRET=
# Resend → Webhooks signing secret (whsec_...). Required by
# /api/webhooks/resend so a bounce can be matched back to its booking.
RESEND_WEBHOOK_SECRET=

# Dedicated secrets for signed onboarding/review links. If unset they fall
# back to SUPABASE_SERVICE_ROLE_KEY; set them in production.
ONBOARDING_TOKEN_SECRET=
REVIEW_LINK_SECRET=

# Cloudflare Turnstile (booking spam protection). The matching site key lives
# in Noire/js/config.js as turnstileSiteKey. Leave both empty to disable.
TURNSTILE_SECRET_KEY=

# Secret for /api/cron/reminders (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# Days before closed bookings are anonymised by the daily retention pass in
# /api/cron/reminders. Must be >= 30 (default 365).
RETENTION_DAYS=365

# Public engine origin used in booking and approval links.
NEXT_PUBLIC_SITE_URL=

# Onboarding review inbox and sender. Never a personal address.
ONBOARDING_REVIEW_EMAIL=hello@agure.space
ONBOARDING_FROM=
EMAIL_FROM_ADDRESS=booking@agure.space

# Development-only admin bypass. Leave empty in production.
ADMIN_FALLBACK_EMAIL=
ADMIN_FALLBACK_TENANT=

# Comma-separated extra origins. Tenant domains live in the database.
CORS_ALLOWED_ORIGINS=
